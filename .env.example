# Port du serveur backend — NE PAS CHANGER : le frontend appelle http://localhost:3000/api en dur
PORT=3000

# Origine autorisée pour le CORS — l'URL de votre frontend Vite en développement
CORS_ORIGIN=http://localhost:5173

# Cookie de session — générer une valeur aléatoire d'au moins 32 caractères.
# Exemple PowerShell : [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
AUTH_SECRET=

# Connexion PostgreSQL locale — ignorée si DATABASE_URL est défini
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=saint_jude
# Pour Neon, renseigner DATABASE_URL avec la chaîne de connexion du dashboard Neon.
# Le backend active TLS automatiquement pour les hôtes *.neon.tech.
# Garder cette variable vide uniquement pour utiliser PostgreSQL local ci-dessous.
DATABASE_URL=
DB_SSL=false

# Intégration OpenAI pour la planification des réservations.
# Vérifiez que le modèle choisi est disponible sur votre compte OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Secrets are required before enabling the matching privileged endpoints.
MCP_BEARER_TOKEN=
RAG_ADMIN_TOKEN=
OBSERVABILITY_TOKEN=
AI_APPROVAL_TOKEN=
