# Port du serveur backend — NE PAS CHANGER : le frontend appelle http://localhost:3000/api en dur
PORT=3000

# Origine autorisée pour le CORS — l'URL de votre frontend Vite en développement
CORS_ORIGIN=http://localhost:5173

# Connexion PostgreSQL locale — ignorée si DATABASE_URL est défini
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=saint_jude
# En production, renseigner DATABASE_URL dans les variables secrètes de l'hébergeur.
# Activer DB_SSL uniquement si le fournisseur PostgreSQL l'exige.
DATABASE_URL=
DB_SSL=false
